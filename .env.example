# Copy file này thành .env và điền key thật. KHÔNG tải file .env lên GitHub.
MODEL_API_KEY=LLM_dan-key-cua-ban-vao-day
MODEL_NAME=muse-spark-1.3
# Key FPT.AI để Mai Anh nói bằng giọng nữ tiếng Việt thật (giọng banmai).
# Lấy tại https://console.fpt.ai (đăng ký FPT ID → tạo Project → bật Text to Speech → copy API key).
FPT_API_KEY=dan-key-fpt-ai-cua-ban-vao-day
FPT_TTS_VOICE=banmai
PORT=3000
